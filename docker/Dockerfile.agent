# Image of the agent (base station of an apartment). Separate from
# Dockerfile.fleet, because an apartment can run an older version while the
# cloud has long since been updated -- see sections 13 and 17 of the
# specification (desired-state reconciliation, rollback on missing heartbeat).
FROM python:3.13-slim AS build
WORKDIR /build
COPY pyproject.toml LICENSE ./
COPY protocol ./protocol
COPY agent ./agent
# watchdog/ has been a standalone Go module since section 18.3, not a
# Python package -- none of it is copied into this image. agent/loop.py
# writes the shared contract (state file) itself, without an import from
# watchdog/.
RUN pip install --no-cache-dir --prefix=/install ".[agent]"

FROM python:3.13-slim
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"
# uid/gid 10002 pinned explicitly (both, not just the uid) -- P5.7 hot fix,
# cross-review: image/common/tmpfiles.d/thermoctl-agent.conf and
# image/common/agent-compose.yml's mounted directories rely on this exact
# numeric id to give the agent write access to /run/thermoctl-agent and
# /var/lib/thermoctl-watchdog on the host, where no "agent" user/group
# exists to resolve a name against -- an implicit, auto-picked gid from a
# bare `useradd` would make that agreement a coincidence instead of a
# contract. See docs/STATUS.md's P5.7 hot-fix entry for the full account.
RUN groupadd --system --gid 10002 agent \
    && useradd --system --create-home --uid 10002 --gid 10002 agent
COPY --from=build /install /usr/local
USER agent
WORKDIR /app
CMD ["python", "-m", "agent"]
