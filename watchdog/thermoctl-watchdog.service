# Beispiel-Einheit für den Wächter (Abschnitt 17, 18.3). Wird als Teil des
# vorbereiteten Systemabbilds ausgeliefert (Abschnitt 15.3) und über die
# Paketverwaltung des Betriebssystems aktualisiert -- ausdrücklich NICHT über
# den Fleet-Dienst und NICHT als Docker-Container: Der Wächter muss gerade
# dann laufen, wenn die Container es nicht tun.
#
# Installation (Beispiel, kein automatisiertes Werkzeug -- bewusst, siehe
# docs/STATUS.md). Setzt voraus, dass das für die Zielarchitektur gebaute
# Binärprogramm (CI, siehe .github/workflows/go.yml) bereits unter
# /usr/local/bin/thermoctl-waechter liegt -- auf dem Gerät wird nichts
# übersetzt (Abschnitt 18.3):
#   install -m 755 thermoctl-waechter-<arch> /usr/local/bin/thermoctl-waechter
#   install -m 644 waechter/thermoctl-waechter.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now thermoctl-waechter.service

[Unit]
Description=thermoctl-Waechter (tauscht den Agent-Container, kein Netz, keine Registry)
# Bewusst kein "After=docker.service"/"Requires=docker.service": Der Wächter
# muss unabhängig von der Containerlaufzeit starten können, um deren Ausfall
# überhaupt bemerken zu können.
After=network.target

[Service]
Type=simple
# Statisch gebautes Binärprogramm (CGO_ENABLED=0, Abschnitt 18.3) -- keine
# Laufzeitumgebung, kein venv, kein Interpreter, der selbst kaputtgehen kann.
ExecStart=/usr/local/bin/thermoctl-waechter
Restart=always
RestartSec=5
# Kein Netz, wie in Abschnitt 18.3 gefordert: Der Wächter braucht keinen
# Netzwerkzugriff, um Container lokal zu starten, zu stoppen oder eine
# Zustandsdatei zu lesen.
PrivateNetwork=true
# Läuft mit den Rechten, die zum Ansprechen der Containerlaufzeit nötig sind
# (z. B. Mitgliedschaft in der "docker"-Gruppe) -- nicht als root. Welche
# konkrete Gruppe/Runtime das ist, hängt vom vorbereiteten Systemabbild ab
# (Abschnitt 15.3) und ist hier nicht festgelegt.
User=thermoctl-waechter
Group=docker

[Install]
WantedBy=multi-user.target
