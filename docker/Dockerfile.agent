# Image of the agent (base station of an apartment). Separate from
# Dockerfile.fleet, because an apartment can run an older version while the
# cloud has long since been updated -- see sections 13 and 17 of the
# specification (desired-state reconciliation, rollback on missing heartbeat).
FROM python:3.13-slim AS build
WORKDIR /build
COPY pyproject.toml LICENSE ./
COPY protocol ./protocol
COPY agent ./agent
# watchdog/ has been a standalone Go module since section 18.3, not a
# Python package -- none of it is copied into this image. agent/loop.py
# writes the shared contract (state file) itself, without an import from
# watchdog/.
RUN pip install --no-cache-dir --prefix=/install ".[agent]"

FROM python:3.13-slim
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"
RUN useradd --system --create-home --uid 10002 agent
COPY --from=build /install /usr/local
USER agent
WORKDIR /app
CMD ["python", "-m", "agent"]
